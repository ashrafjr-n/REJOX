# Rejox AI — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# --- AI Resolution Engine -------------------------------------------------
# Provider: "gemini" (real) or "fake" (deterministic, offline — used by tests).
REJOX_AI_PROVIDER=gemini

# Google Gemini (official google-genai SDK). Required when REJOX_AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Flash-tier model by default; override to trade cost/quality.
GEMINI_MODEL=gemini-2.5-flash

# Resolution cache (SQLite path). Recurring residue is resolved once and reused.
REJOX_AI_CACHE=backend/.rejox-ai-cache.sqlite3

# Snippet+context line budget for a single ResolutionRequest. The AI layer
# resolves residue, never whole files — over-budget requests are refused.
REJOX_AI_MAX_SNIPPET_LINES=60

# --- Workspace location (docker compose) ----------------------------------
# Where run workspaces live. Bind-mounted at the SAME path inside the
# containers, because a sandbox container is started by the HOST's daemon: it
# resolves the mount against the host's filesystem, not the worker's. A path
# that means two different things would mount an empty directory and every
# validation would pass against nothing. Create it first, owned by the `rejox`
# uid the image runs as:
#
#   sudo mkdir -p /srv/rejox-data && sudo chown -R 10001:10001 /srv/rejox-data
#
REJOX_DATA_DIR=/srv/rejox-data

# The gid that owns /var/run/docker.sock. The socket is mode 0660 and the image
# runs as a non-root uid, so the worker needs this group to start a sandbox
# container at all — without it every migration fails with "permission denied
# while trying to connect to the docker API".
#   Linux:          stat -c '%g' /var/run/docker.sock
#   Docker Desktop: 0
REJOX_DOCKER_GID=0

# --- Sandbox (running an uploaded project's toolchain) --------------------
# Validating a migration means running `npm install`, `tsc` and Metro against a
# project someone uploaded. That is arbitrary code execution, so it is contained.
#
#   docker  — every command runs in a throw-away container: no capabilities,
#             non-root, memory/CPU/pid caps, and network ONLY for the install
#             step. Required for any server that accepts uploads.
#   direct  — runs as the Rejox process. Developer convenience, NOT a sandbox.
REJOX_SANDBOX=docker
REJOX_SANDBOX_IMAGE=node:20-bookworm-slim
REJOX_SANDBOX_MEMORY=4g
REJOX_SANDBOX_CPUS=2
REJOX_SANDBOX_PIDS=512

# Accept running untrusted project code WITHOUT containment. Local development
# only — with this unset, /api/migrate refuses to start in `direct` mode.
# REJOX_ALLOW_UNSANDBOXED=1

# Dependency lifecycle scripts (postinstall etc.) are arbitrary code from a tree
# the uploader influences, so installs run with --ignore-scripts. Uncomment only
# for a project you trust that genuinely cannot install without them.
# REJOX_NPM_ALLOW_SCRIPTS=1

# --- API access -----------------------------------------------------------
# Shared API keys, comma-separated. With none set, the API refuses to serve
# (503) unless REJOX_ALLOW_ANONYMOUS=1 is set for a local dev server.
REJOX_API_KEYS=
# REJOX_ALLOW_ANONYMOUS=1

# A run belongs to the identity that created it; nobody else can read it.
# `{"path": ...}` bypasses that — it reads a server directory the caller picks —
# so it is refused (403) unless this is set for a local dev server.
# REJOX_ALLOW_LOCAL_PATH=1

# Browser origins allowed to call the API. Never a wildcard.
REJOX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Budgets (per identity, per 60s) --------------------------------------
# Where the counters live. `memory` counts in each API process — correct for a
# single container, and N times the ceiling behind N replicas. `redis` shares
# them across the fleet, using REJOX_REDIS_URL; docker-compose.yml sets it.
# An unreachable shared store answers 503 rather than counting locally.
REJOX_RATE_STORE=memory
REJOX_RATE_READ=300
REJOX_RATE_UPLOAD=10
REJOX_RATE_PIPELINE=20
REJOX_RATE_MIGRATE=3
# Concurrent migrations on this box (each one installs + bundles a project).
REJOX_MAX_CONCURRENT_MIGRATIONS=2

# --- Job queue ------------------------------------------------------------
# Where a migration actually runs.
#   rq      — enqueued to Redis, executed by `rejox-worker` processes. Jobs
#             survive an API restart and scale across workers. Production.
#   thread  — a daemon thread inside the API process. No Redis, no durability:
#             a job running when the process dies is gone. Dev/CLI only.
REJOX_QUEUE=rq
REJOX_REDIS_URL=redis://localhost:6379/0
REJOX_QUEUE_NAME=rejox-migrations
# Ceiling for one migration (install + tsc + Metro), and the Redis connect/read
# timeout — small, so an unreachable queue answers 503 instead of hanging.
REJOX_JOB_TIMEOUT=3600
REJOX_REDIS_TIMEOUT=5
# How a job whose worker died stops looking alive. The process running a
# migration stamps job.json every REJOX_JOB_HEARTBEAT seconds; a reader that
# finds a `running` job with no beat for REJOX_JOB_HEARTBEAT_GRACE seconds marks
# it `failed`. Widen the grace on a slow or heavily contended host — the cost of
# too narrow a grace is a live migration reported as lost.
REJOX_JOB_HEARTBEAT=10
REJOX_JOB_HEARTBEAT_GRACE=60

# --- Browser sessions ------------------------------------------------------
# An API key is the right credential for a CLI and the wrong one for a browser:
# EventSource and download links cannot send a header at all, so the browser app
# authenticates with an httpOnly cookie instead. A code is exchanged for one at
# POST /api/session. A server needs API keys, invite codes, or both.
REJOX_INVITE_CODES=invite-one,invite-two
# Signs the cookie. NO DEFAULT, on purpose: a baked-in fallback would mean every
# deployment that forgot to set one shared a signing key, and anyone could mint
# a session for any Rejox server. Generate with: openssl rand -hex 32
REJOX_SESSION_SECRET=
# How long a session lasts (seconds). 12h — outlives a working day without
# becoming a permanent credential in a browser profile.
REJOX_SESSION_TTL=43200
# The cookie is Secure (HTTPS only) and SameSite=Lax. Lax is what keeps CSRF off
# this surface without a token, and it works because the app and the API are
# served from ONE origin (Vite proxies in dev; a reverse proxy in production).
# Set this ONLY on a local machine on plain http — it is refused unless
# REJOX_ALLOW_ANONYMOUS is also set, so it cannot be turned on by accident on a
# real server.
# REJOX_COOKIE_INSECURE=1

# --- Storage ceilings ------------------------------------------------------
# The rate limit caps requests and the archive guard caps one upload; without
# these, nothing caps their SUM. 10 uploads/min x 500 MB expanded is 300 GB/hour
# for one identity, held for a full retention window (gate E1).
# 2 GB is about 50 runs at the ~40 MB/run measured at gate B7.
REJOX_ACCOUNT_QUOTA_BYTES=2147483648
# Stop accepting uploads while the volume is this close to full, so the server
# refuses new work before it cannot finish what it already has.
REJOX_MIN_FREE_BYTES=2147483648

# --- Logging ---------------------------------------------------------------
# One JSON line per event, carrying the run id, job id and the caller's identity
# digest — never a key or an invite code. `text` for a readable terminal format.
REJOX_LOG_FORMAT=json
REJOX_LOG_LEVEL=INFO

# --- Retention ------------------------------------------------------------
# A run workspace holds an uploaded project and the RN project emitted from it,
# so this is a data-retention window, not just disk hygiene. The API sweeps on
# an interval; set REJOX_RETENTION=off and drive `rejox sweep` from cron instead.
REJOX_RUN_TTL_SECONDS=86400
REJOX_SWEEP_INTERVAL_SECONDS=3600
REJOX_RETENTION=on

# --- Upload limits --------------------------------------------------------
REJOX_MAX_ARCHIVE_BYTES=104857600
REJOX_MAX_UNCOMPRESSED_BYTES=524288000
REJOX_MAX_FILE_COUNT=20000
